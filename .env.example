# TestPrep Admissions — environment template (Supabase NOT connected yet)
NEXT_PUBLIC_SITE_URL=https://testprep-admissions.example

# Supabase (leave empty until migration; see docs/supabase-migration.md)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Ingestion pipeline (used by Python scripts when network access is enabled)
# Default identity source is ROR (api.ror.org) — authoritative & curated.
# Allow api.ror.org in the network egress settings for the default source.
ROR_API=https://api.ror.org/v2/organizations
OPENALEX_MAILTO=you@example.com           # polite pool (OpenAlex fallback)
WIKIDATA_SPARQL_ENDPOINT=https://query.wikidata.org/sparql   # community-edited fallback
INGEST_CACHE_DIR=.cache/ingest            # cache-first behavior
INGEST_USER_AGENT=TestPrepAdmissionsBot/0.1 (contact: you@example.com)
